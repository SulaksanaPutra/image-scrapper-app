# ClassifyKit Configuration
APP_NAME=ClassifyKit
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Settings
DATABASE_URL=sqlite:///./classifykit.db

# Model & Storage Settings
MODEL_REGISTRY_DIR=./models
ACTIVE_MODEL_VERSION=v1.0.0
DEFAULT_BASE_MODEL=distilbert-base-uncased
DEFAULT_ENGINE=sklearn  # 'sklearn' or 'transformer'

# Minimum F1 accuracy required to auto-promote a retrained model to active
AUTO_PROMOTE_F1_THRESHOLD=0.75

# LLM Fallback (Optional)
GEMINI_API_KEY=
